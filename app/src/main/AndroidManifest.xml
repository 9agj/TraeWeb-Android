<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.TraeWeb"
        android:extractNativeLibs="true">

        <!-- 内地中转站二进制必须解压到磁盘才能 exec，见 build.gradle 的 useLegacyPackaging -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 中转站控制台：独立 WebView，加载本机 127.0.0.1 上的 Go 服务面板 -->
        <activity
            android:name=".RelayConsoleActivity"
            android:exported="false"
            android:label="接入地址控制台"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />

        <!--
            内置登录页：在 App 自己的 WebView 里完成 Trae 登录。
            这样 X-Cloudide-Session 落在本 App 的 cookie jar 里，可直接读取明文；
            系统浏览器的 cookie 库是 v10 加密（密钥在 TEE），root 也解不开。
        -->
        <activity
            android:name=".LoginWebViewActivity"
            android:exported="false"
            android:label="登录 Trae"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
